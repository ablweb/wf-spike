#!/bin/bash
# forge ROLE VERB ...: the pipeline's access to the forge. It is called by the hook (agent-done.sh next to it) and by the operator's scripts, never by an
# agent: agents hold no credential and have no way to run it. Each role is a fixed list of verbs: no commit status, no
# review-request edit, no comment-only review. Tokens stay in the state folder (lib.sh).
#   forge dev    sync | fetch-main | push [--force-with-lease] | pr-open TITLE TASK | pr-of [BRANCH] | automerge N | update-branch N | pr-behind N | pr-show N
#                ci-wait N [SECONDS] | ci-log N | task-show N | task-labels N | task-status N todo|in-review | review-request N bot-review|operator
#   forge review pr-of BRANCH | pr-show N | pr-diff N | approve N SHA [-] | request-changes N SHA -
#   forge operator  pr-json N | pr-list open|merged | pr-create BRANCH TITLE BODY | ci-state SHA | reviews N | approve N SHA - | unrequest N LOGIN... | comment N TEXT
#                   merge N [--force] | task-json N | task-list | task-new TITLE BODY LABEL... | protect-files PATTERNS    (the operator's scripts, JSON answers)
#                   repo-url | git ARGS...   (git as the operator on the project's repository)
# A review body is read from stdin ("-"). Verbs that touch local state (push, sync, pr-open) only work inside a managed checkout
# (FORGE_WORK, default .wf/work/*; the hook sets it to the project). push and
# pr-open work on the checked out branch; push refuses a branch that changes a class C file (CI, ownership, Makefile,
# scripts: see wf.yml): those are changed by the operator or the human, never by agents. sync rebases the branch onto the
# forge's main (a branch cut from an older main is blocked by the outdated-branch rule); on conflicts it aborts, says so and exits 3.
# task-labels prints the task's label names, one per line (nothing when there is no such task). review-request asks bot-review or operator for a review of PR N,
# as its author: the forge holds the merge until that reviewer reviews (the operator's policy marks the tasks that get one).
# update-branch merges main into the branch of a PR on the forge that fell behind while it waited for its review. pr-open writes the closing keyword
# for TASK itself. automerge (as bot-merge) schedules the squash merge for when the checks pass; call it right after a push,
# a schedule made after CI finished never fires; the server still waits for approvals. approve and request-changes name the
# head SHA that was reviewed and are refused when the PR has moved on. The repos come from .claude/wf.json; FORGE_APP and FORGE_TASKS override them.
# The git verbs (push, sync, fetch-main) are here; every other verb is done by the host file of the project's forge (forge.host of .claude/wf.json,
# default forgejo: host-forgejo.sh next to this file), which says what each verb answers.
set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
[ -z "${WF_FORGE_LOG:-}" ] || exec 2> >(tee -a "$WF_FORGE_LOG" >&2)   # for the checks: what the tool said on stderr is kept in that file (the hook shows only that a verb failed)

APP=${FORGE_APP:-$(wfcfg .app)} TASKS=${FORGE_TASKS:-$(wfcfg .tasks)} WORK=${FORGE_WORK:-$STATE/work}
die() { say "forge: $*"; exit 2; }
num() { [[ ${1:-} =~ ^[0-9]+$ ]] || die "not a number: ${1:-}"; }

role=${1:-}; verb=${2:-}; [ $# -ge 2 ] || die "usage: forge dev|review|operator VERB ..."; shift 2
case $role in dev) U=bot-dev;; review) U=bot-review;; operator) U=operator;; *) die "unknown role: $role";; esac
HOST=$(wfcfg '.forge.host // "forgejo"'); HOST=${HOST:-forgejo}
[[ $HOST =~ ^[a-z]+$ ]] && [ -f "$WF_LIB/host-$HOST.sh" ] || die "unknown forge host: $HOST"
. "$WF_LIB/host-$HOST.sh"
! declare -F host_init >/dev/null || host_init || exit 1   # the host's own preparation (GitHub: the token of the role)

clone() { # the managed clone that contains the current directory, else die
  local top w; top=$(git rev-parse --show-toplevel 2>/dev/null) && top=$(realpath -e -- "$top") && w=$(realpath -m -- "$WORK") || die "not in a git repository"
  case $top in "$w"/*) echo "$top";; *) die "run it inside a managed clone ($w/*)";; esac; }
branch() { local b; b=$(git symbolic-ref --short HEAD 2>/dev/null) || die "detached HEAD"
  case $b in main|master) die "refusing to work on $b";; esac
  [[ $b =~ ^[A-Za-z0-9._/-]+$ ]] || die "odd branch name"; echo "$b"; }

case $role/$verb in
  dev/push)
    clone >/dev/null || exit 2; b=$(branch) || exit 2; force=; [ "${1:-}" = --force-with-lease ] && force=--force-with-lease
    # push from a clean bare repo, so nothing in the agent's own .git/config (url rewrites, hooks, proxies) sees the token
    t=$(mktemp -d "$STATE/push.XXXXXX"); trap 'rm -f "$BODY"; rm -rf "$t"' EXIT
    git init -q --bare "$t" && git -C "$t" fetch -q "$PWD" "+HEAD:refs/heads/$b" || die "cannot read the current branch"
    git_as "$U" -C "$t" fetch -q "$BASE/$APP.git" main:refs/heads/_main || die "cannot read main"
    if [ -n "$force" ]; then   # lease on the value the forge has right now
      rb=$(git_as "$U" -C "$t" ls-remote "$BASE/$APP.git" "refs/heads/$b" | cut -f1); force=${rb:+--force-with-lease=refs/heads/$b:$rb}
    fi
    c=$(git -C "$t" diff --no-renames --name-only "_main...$b" | python3 "$WF_LIB/paths.py" classify | sed -n 's/^C //p')
    [ -z "$c" ] || die "class C files are changed by the operator or the human, not by agents; remove from this branch: $(tr '\n' ' ' <<<"$c")"
    git_as "$U" -C "$t" push -q $force "$BASE/$APP.git" "refs/heads/$b:refs/heads/$b" && say "pushed $b";;
  dev/sync)   # the token only touches a clean bare repo; the checkout gets main through a local fetch
    clone >/dev/null || exit 2; b=$(branch) || exit 2
    t=$(mktemp -d "$STATE/sync.XXXXXX"); trap 'rm -f "$BODY"; rm -rf "$t"' EXIT
    git init -q --bare "$t" && git_as "$U" -C "$t" fetch -q "$BASE/$APP.git" main:refs/heads/main || die "cannot read main"
    ok=; for _ in 1 2 3; do git fetch -q "$t" +refs/heads/main:refs/wf/main 2>/dev/null && { ok=1; break; }; sleep 1; done   # parallel syncs share the repository's refs
    [ -n "$ok" ] || die "cannot bring main into the checkout"
    if git merge-base --is-ancestor refs/wf/main HEAD; then echo "up to date with main"
    elif git rebase -q refs/wf/main >/dev/null 2>&1; then echo "rebased onto main"
    else files=$(git diff --name-only --diff-filter=U | tr '\n' ' '); git rebase --abort >/dev/null 2>&1
      say "forge: main moved and the branch conflicts with it (${files% }); the rebase was undone"; exit 3; fi;;
  dev/fetch-main)   # the forge's main into the project checkout (origin/main, and main itself when it is checked out and clean): Claude Code cuts a
    # subagent's worktree from origin/main and was seen not to fetch it first, so a task that needs a merged one started on stale code
    c=$(git rev-parse --show-toplevel 2>/dev/null) && [ "$(realpath -e -- "$c")" = "$(realpath -m -- "$WORK")" ] || die "run it in the project checkout (FORGE_WORK)"
    t=$(mktemp -d "$STATE/fetch.XXXXXX"); trap 'rm -f "$BODY"; rm -rf "$t"' EXIT
    git init -q --bare "$t" && git_as "$U" -C "$t" fetch -q "$BASE/$APP.git" main:refs/heads/main || die "cannot read main"
    git -C "$c" fetch -q "$t" +refs/heads/main:refs/remotes/origin/main || die "cannot bring main into the checkout"
    if [ "$(git -C "$c" symbolic-ref --short HEAD 2>/dev/null)" = main ] && [ -z "$(git -C "$c" status --porcelain --untracked-files=no)" ]; then
      git -C "$c" merge -q --ff-only refs/remotes/origin/main >/dev/null 2>&1 || true
    fi
    echo "main at $(git -C "$c" rev-parse --short refs/remotes/origin/main)";;
  operator/repo-url) echo "$BASE/$APP.git";;   # for the operator's scripts: git as the operator, on the project's forge
  operator/git) git_as "$U" "$@";;
  *) fn=h_${role}_${verb//-/_}; declare -F "$fn" >/dev/null || die "no verb '$verb' for role $role"; "$fn" "$@";;
esac
rc=$?; [ -z "${WF_FORGE_LOG:-}" ] || echo "forge $role $verb: $SECONDS s, exit $rc" >&2; exit $rc
